<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>WishDays</title>
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="WishDays">
<meta name="theme-color" content="#2f8f5b">
<link rel="apple-touch-icon" href="data:image/png;base64,">
<link rel="icon" type="image/png" href="data:image/png;base64,">
<style>
:root{--bg:#f6f4ef;--card:#fff;--text:#1f2420;--muted:#6b726c;--accent:#2f8f5b;--accent2:#e8f4ec;--line:#e3e0d8;--warn:#c0492f;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#141815;--card:#1e241f;--text:#eef1ee;--muted:#9aa39c;--accent:#4cc486;--accent2:#22332a;--line:#2d352f;--warn:#e8765c}}
:root[data-theme="dark"]{--bg:#141815;--card:#1e241f;--text:#eef1ee;--muted:#9aa39c;--accent:#4cc486;--accent2:#22332a;--line:#2d352f;--warn:#e8765c}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;line-height:1.4}
main{max-width:480px;margin:0 auto;padding:20px 16px 40px}
h1{font-size:24px;margin:8px 0 18px}
h2{font-size:15px;margin:0 0 12px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.05em}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:16px;margin-bottom:14px}
.row{display:flex;align-items:center;justify-content:space-between;gap:10px}
.big{font-size:44px;font-weight:700;line-height:1;color:var(--accent)}
.sub{color:var(--muted);font-size:13px}
.dots{display:flex;gap:6px;margin:12px 0}
.dot{flex:1;text-align:center;font-size:11px;color:var(--muted)}
.dot i{display:block;height:26px;border-radius:8px;background:var(--accent2);border:1px solid var(--line);margin-bottom:3px}
.dot.on i{background:var(--accent);border-color:var(--accent)}
button{font:inherit;border:0;border-radius:12px;padding:12px 14px;cursor:pointer;background:var(--accent);color:#fff;font-weight:600}
button.ghost{background:var(--accent2);color:var(--text)}
button.full{width:100%}
button.small{padding:6px 10px;font-size:12px}
input{font:inherit;width:100%;padding:11px 12px;border-radius:12px;border:1px solid var(--line);background:var(--bg);color:var(--text)}
.bar{height:16px;border-radius:99px;background:var(--accent2);overflow:hidden;margin:12px 0 6px;border:1px solid var(--line)}
.bar>div{height:100%;background:var(--accent);width:0;transition:width .4s}
